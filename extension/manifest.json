{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "0.2.0",
  "description": "__MSG_description__",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_name__"
  },
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://127.0.0.1/*"
  ],
  "minimum_chrome_version": "116",
  "default_locale": "en"
}
